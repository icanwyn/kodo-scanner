# --- Database (required) ---
# Local (docker compose up -d):
# DATABASE_URL="postgresql://kodo:kodo@localhost:5432/kodo"
# Vercel / production: Neon or Vercel Postgres connection string (use pooled URL)
DATABASE_URL="postgresql://kodo:kodo@localhost:5432/kodo"

# Market data
ENABLE_YAHOO=true
SCAN_MAX_SYMBOLS=50

# Deep analysis (xAI / SpaceXAI) — https://console.x.ai
# XAI_API_KEY=xai-...
XAI_MODEL=grok-4.5
XAI_MODEL_FALLBACK=grok-3
ANALYSIS_DAILY_BUDGET=40

# Optional market providers
# FINNHUB_API_KEY=
# POLYGON_API_KEY=
# TWELVE_DATA_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# Optional local password gate
# APP_PASSWORD=

LOG_LEVEL=info
